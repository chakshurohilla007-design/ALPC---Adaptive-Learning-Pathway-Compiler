PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/learnsmart?retryWrites=true&w=majority
JWT_SECRET=learnsmart-dev-secret-change-in-production
ML_SERVICE_URL=http://127.0.0.1:8000
FRONTEND_URL=http://localhost:3000
# Registered accounts allowed to confirm written answers; set this on the server only.
# THEORY_REVIEWER_EMAILS=teacher@example.com

# ALPC compiler + LLVM interpreter. Defaults: <repo>/alpc.exe and `lli` on PATH.
# ALPC_BIN=C:/path/to/ALPC/alpc.exe
# LLI_BIN=C:/msys64/mingw64/bin/lli.exe
# OPT_BIN=C:/msys64/mingw64/bin/opt.exe   (LLVM optimizer for the playground's Optimized tab)

# In production: NODE_ENV=production and a private JWT_SECRET of 32+ characters,
# e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# NODE_ENV=production

# Hosting: use the exact frontend origin without a trailing slash.
# TRUST_PROXY_HOPS=1  # Render's proxy only; leave unset for direct local access
# ML_TIMEOUT_MS=120000
# ML_SERVICE_HOST=your-ml-service.onrender.com  # HTTPS; used only if ML_SERVICE_URL is unset
